# --- Frontend (Vue) ---
# Базовый URL API. Для локальной разработки обычно http://localhost:3000
VUE_APP_API_URL=http://localhost:3000

# --- Backend (Node.js / Express) ---
# Строка подключения к MongoDB (например, MongoDB Atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Имя базы данных
DB_NAME=BookPlatform

# Секрет для подписи JWT-токенов (задайте длинную случайную строку)
JWT_SECRET=change_me_to_a_long_random_secret
